#!/usr/bin/env python3
import os
import sys
import subprocess
from pathlib import Path

# Add project root directory to path for robust core module resolution
PROJECT_ROOT = str(Path(__file__).resolve().parent.parent)
if PROJECT_ROOT not in sys.path:
    sys.path.insert(0, PROJECT_ROOT)

from core.security import validate_cwd, load_config
from core.ollama_client import OllamaClient
from core.context_builder import ContextBuilder

# Premium Terminal Colors
COLOR_RESET = "\033[0m"
COLOR_BOLD = "\033[1m"
COLOR_RED = "\033[38;5;196m"
COLOR_TEAL = "\033[38;5;38m"
COLOR_AMBER = "\033[38;5;214m"

def print_err(text):
    print(f"{COLOR_RED}{COLOR_BOLD}taiga-git: {text}{COLOR_RESET}", file=sys.stderr)

def run_cmd(args):
    """Safely runs a system command and returns stdout."""
    try:
        res = subprocess.run(args, capture_output=True, text=True, check=True)
        return res.stdout.strip()
    except subprocess.CalledProcessError:
        return ""

def main():
    # 1. Security Check: Enforce workspace CWD bounds
    validate_cwd()

    # 2. Verify Git Repository
    git_check = run_cmd(["git", "rev-parse", "--is-inside-work-tree"])
    if git_check != "true":
        print_err("Current directory is not inside a Git repository.")
        sys.exit(1)

    # 3. Load configuration
    config = load_config()
    models = config.get("models", {})
    ollama_url = config.get("ollama_url", "http://localhost:11434")

    # Parse arguments
    command = sys.argv[1] if len(sys.argv) > 1 else "commit"

    if command in ("commit", "msg"):
        # Check staged changes
        staged_diff = run_cmd(["git", "diff", "--cached"])
        if not staged_diff:
            print(f"{COLOR_AMBER}{COLOR_BOLD}taiga-git: No staged changes detected. Stage changes first using 'git add'.{COLOR_RESET}", file=sys.stderr)
            sys.exit(0)

        system_prompt = """You are an expert Git Assistant. Analyze the staged diff provided and generate a clean, clear, and highly standard Conventional Commit message.

Guidelines:
1. Follow the Conventional Commits specification: <type>(<scope>): <description> (e.g. feat(auth): add JWT validator).
2. Common types: feat (new feature), fix (bug fix), docs (documentation), style (formatting), refactor (code restruct), test (adding/fixing tests), chore (maintenance).
3. Use the imperative mood in the description (e.g., 'add' instead of 'adds' or 'added').
4. Keep the first line under 72 characters.
5. If the diff is large or complex, optionally append a brief, high-value bulleted list describing significant changes separated by a blank line.
6. DO NOT include markdown code blocks, backticks around the commit message itself, or any conversational intro/outro. Print ONLY the commit message."""

        # Build Normalized Context
        builder = ContextBuilder()
        builder.add_git_diff(staged_diff, diff_type="cached")
        prompt = builder.build()

        model = models.get("coder", "qwen2.5-coder:3b")
        print(f"{COLOR_TEAL}{COLOR_BOLD}[Git Commit Assistant | {model}]{COLOR_RESET}", file=sys.stderr)

        client = OllamaClient(base_url=ollama_url)
        client.query(model=model, prompt=prompt, system_prompt=system_prompt)

    elif command in ("summarize", "pr"):
        # Check branch diff against main/master
        default_branch = run_cmd(["git", "symbolic-ref", "refs/remotes/origin/HEAD"])
        if default_branch:
            default_branch = default_branch.split("/")[-1]
        else:
            default_branch = "main"

        diff_args = ["git", "diff", f"{default_branch}...HEAD"]
        branch_diff = run_cmd(diff_args)
        diff_type = "branch"

        if not branch_diff:
            # Fallback to staged diff
            branch_diff = run_cmd(["git", "diff", "--cached"])
            diff_type = "cached"
            if not branch_diff:
                print_err("No changes found to summarize. Stage changes or commit to a branch first.")
                sys.exit(1)

        system_prompt = """You are an expert Git Assistant. Analyze the provided diff of changes and generate a high-quality Pull Request (PR) description.

Format the output in clean, professional Markdown with:
- **Summary**: A concise 2-3 sentence overview of the purpose and goals of these changes.
- **Key Changes**: A clear bulleted list detailing significant updates grouped logically by file or module.
- **Testing & Verification Notes**: Suggested validation vectors and testing considerations.

Keep it direct, professional, and focus exclusively on the actual changes present in the diff. Output only the Markdown description."""

        # Build Normalized Context
        builder = ContextBuilder()
        builder.add_git_diff(branch_diff, diff_type=diff_type)
        prompt = builder.build()

        model = models.get("thinker", "llama3.2:3b")
        print(f"{COLOR_TEAL}{COLOR_BOLD}[Git PR Summarizer | {model}]{COLOR_RESET}", file=sys.stderr)

        client = OllamaClient(base_url=ollama_url)
        client.query(model=model, prompt=prompt, system_prompt=system_prompt)

    elif command in ("help", "--help", "-h"):
        print(f"{COLOR_TEAL}{COLOR_BOLD}taiga-git: Security-Hardened Local Git Assistant{COLOR_RESET}")
        print("Usage:")
        print("  taiga-git commit      Generate a Conventional Commit message from staged diffs (default)")
        print("  taiga-git summarize   Generate a structured Pull Request markdown summary of branch changes")
        print("  taiga-git help        Show this message")
        print("")
        print("Safety Mode: Read-only access. Auto-commit is disabled. Copy output or run:")
        print("  git commit -m \"$(taiga-git)\"")
    else:
        print_err(f"Unknown command: {command}")
        print("Run 'taiga-git help' for options.")
        sys.exit(1)

if __name__ == "__main__":
    main()
