#!/usr/bin/env python3
import sys
from pathlib import Path

# Add project root directory to path for robust core module resolution
PROJECT_ROOT = str(Path(__file__).resolve().parent.parent)
if PROJECT_ROOT not in sys.path:
    sys.path.insert(0, PROJECT_ROOT)

from core.security import validate_path, validate_cwd, load_config
from core.context_builder import ContextBuilder
from core.ollama_client import OllamaClient

# Premium Terminal Colors
COLOR_RESET = "\033[0m"
COLOR_BOLD = "\033[1m"
COLOR_TEAL = "\033[38;5;38m"
COLOR_RED = "\033[38;5;196m"

def main():
    # 1. Security Check: Enforce workspace CWD bounds
    validate_cwd()

    # 2. Verify Inputs
    # If no files are passed and stdin is a terminal, print usage help
    if len(sys.argv) < 2 and sys.stdin.isatty():
        print(f"{COLOR_TEAL}{COLOR_BOLD}taiga-review: Secure Local Code Reviewer{COLOR_RESET}")
        print("Usage:")
        print("  taiga-review <file_path>       Review a specific local file")
        print("  cat <file> | taiga-review      Review code piped through stdin")
        sys.exit(0)

    # 3. Load configurations
    config = load_config()
    models = config.get("models", {})
    ollama_url = config.get("ollama_url", "http://localhost:11434")
    model = models.get("coder", "qwen2.5-coder")

    # 4. Normalize contexts
    builder = ContextBuilder()

    # Gather positional file inputs with full absolute Path.resolve() validation
    for fpath in sys.argv[1:]:
        resolved = validate_path(fpath)
        try:
            with open(resolved, "r") as f:
                content = f.read()
            builder.add_file(str(resolved), content)
        except Exception as e:
            print(f"{COLOR_RED}Failed to read file '{fpath}': {e}{COLOR_RESET}", file=sys.stderr)
            sys.exit(1)

    # Gather piped stdin input
    if not sys.stdin.isatty():
        builder.add_stdin(sys.stdin.read())

    prompt = builder.build()

    system_prompt = """You are TAIGA-REVIEW, a security-hardened local code reviewer. Your analysis is read-only.
You analyze source code for functional bugs, code quality, logical errors, and standard security flaws.

You MUST conform strictly to the following structured layout. Do not write introductory text, chat greetings, or concluding remarks. Print only the finding blocks. If no issues are found, return a single block indicating 'Severity: Low' and 'Issue: No major issues detected'.

[AI-TOOL: taiga-review]
Severity: [Low/Medium/High]
Issue: <Short and punchy description of the bug or improvement>
Evidence: <File name, function, line numbers, or code snippet>
Fix: <Step-by-step description of the recommended replacement or refactoring>"""

    # 5. Invoke unified query
    print(f"{COLOR_TEAL}{COLOR_BOLD}[Code Auditor | {model}]{COLOR_RESET}", file=sys.stderr)
    client = OllamaClient(base_url=ollama_url)
    success = client.query(
        model=model,
        prompt=prompt,
        system_prompt=system_prompt,
        tool_name="taiga-review"
    )

    if not success:
        sys.exit(1)

if __name__ == "__main__":
    main()
